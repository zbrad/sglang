# tuned/repo.env -- sglang-specific settings for tuned builds. Sourced by tuned/env.sh after the shared
# device and toolkit definitions (tuned/common-data, vendored from zbrad/tuned-common). Tracked, so a
# release is reproducible.
#
# This file only ADDS repo-specific settings. Changing a shared key (GPU_TUNED_VARIANT/PLATFORM/CUDA_ARCH/
# HW_LABEL, CUDA_*, TOOLKIT_*) is a loud error from gpu_tuned_load_repo_env. Plain assignment on purpose:
# this file is sourced inside a function, where `declare` would make the variable local and lose it.

# Upstream ref the build-info stamp and the DRAFT notes compare against (the merge-base of HEAD with it).
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"

# Strings the fork keeps in upstream-owned files; tools/upstream-sync.sh (GPU_TUNED_FORK_MARKERS, comma-separated)
# refuses a merge that loses one. SGL_KERNEL_TUNED_ARCH is the single-arch switch in python/sglang/kernels/aot/CMakeLists.txt.
GPU_TUNED_FORK_MARKERS="gpu_tuned_,zbrad/sglang tuned-builds,SGL_KERNEL_TUNED_ARCH"

case "${GPU_TUNED_VARIANT}" in
    gb10)
        # Upstream's python/pyproject.toml is left as it is (no merge conflicts): the build venv is installed from
        # this requirements file, and package.sh replaces the wheel's Requires-Dist entries named in
        # GPU_TUNED_DROP_DEPS with the lines of this file. torch and flashinfer are zbrad fork wheels (no
        # aarch64/sm_121 builds exist upstream); sglang-kernel is the one this repo builds.
        GPU_TUNED_REQUIREMENTS="tuned/requirements-gb10.txt"
        # Dropped from upstream's dependency list for gb10, each for a reason:
        #   torch, flashinfer_python, sglang-kernel: replaced by the tuned wheels in GPU_TUNED_REQUIREMENTS.
        #   sgl-flash-mla: sm90/sm100a/sm103a kernels only (sgl-project/FlashMLA setup.py CUDA_ARCHS), none for sm_12x.
        #   sgl-deep-gemm: JIT-only (compiles with nvcc at run time); this build allows no runtime nvcc.
        #   sgl-deep-ep: expert parallelism across GPUs (NVSHMEM); this is a single-GPU build.
        #   torchvision: replaced by the zbrad/vision tuned wheel (requirements file). sglang imports it at start-up
        #     (configs/all_configs -> nano_nemotron_vl -> multimodal/internvl_utils), and the stock wheel NEEDs stock libtorch names.
        #   torchaudio: no build exists for the tuned torch; omitted as in zbrad/vllm requirements/gb10.txt.
        #   outlines: optional grammar backend (imported only with --grammar-backend outlines; xgrammar and llguidance stay).
        #     outlines==0.1.11 pins outlines_core==0.1.26, which has no cp314 wheel and whose PyO3 0.22.6 refuses Python 3.14
        #     (build log 2026-11-12). Dropped rather than forked (user decision 2026-11-12).
        #   (timm was dropped 2026-11-12 while no tuned torchvision existed; it is kept again now that one does.)
        GPU_TUNED_DROP_DEPS="torch flashinfer_python sglang-kernel sgl-flash-mla sgl-deep-gemm sgl-deep-ep torchvision torchaudio outlines"
        # The pinned torch and flashinfer wheels are built for cu134 only.
        GPU_TUNED_REPO_TOOLKITS="cu134"
        GPU_TUNED_REPO_TOOLKIT_REASON="The pinned torch and flashinfer wheels (tuned/requirements-gb10.txt) exist for cu134 only; build with CUDA_TAG=cu134."
        ;;
    *)
        echo "ERROR: tuned/repo.env has no settings for variant '${GPU_TUNED_VARIANT}' (only gb10 is set up)." >&2
        return 1
        ;;
esac
